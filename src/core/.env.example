# 私密环境变量模板；首次使用：S0。请复制为 `.env` 并填写，不要提交真实密钥。

# DeepSeek 官方或兼容端点：默认 URL 可直接使用，也可替换为代理地址。
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 第三方 OpenAI-compatible Chat Completions 服务。
THIRD_PARTY_API_KEY=your-third-party-api-key
THIRD_PARTY_BASE_URL=https://your-provider.example.com/v1

# S2–S7 的网页搜索工具仍需要 Tavily。
TAVILY_API_KEY=your-tavily-api-key
